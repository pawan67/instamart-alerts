# ─── Telegram ──────────────────────────────────────────
# From @BotFather. Chat id: message your bot, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and read result[].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Delivery location ─────────────────────────────────
# Anything Swiggy's address search accepts: a pincode, an
# area name, or "Area, City". This picks the dark store,
# which decides both the catalogue and the prices.
IM_AREA=560001

# ─── Optional ──────────────────────────────────────────
# Routes both the browser bootstrap and the polling calls.
# socks5://user:pass@host:port  or  http://user:pass@host:port
# PROXY_URL=

# Set to 0 to watch the bootstrap browser (debugging only).
# IM_HEADLESS=1

# Public HTTPS url of the Mini App, so `im bot` needs no --url.
# IM_WEBAPP_URL=https://your-tunnel.trycloudflare.com

# Skips Mini App signature checks so you can open the UI in a
# normal browser. Localhost only — never on a public URL.
# IM_WEB_DEV=1

# IM_WATCHLIST=./watchlist.json
# IM_DATA_DIR=./data
