# ─── Telegram ──────────────────────────────────────────
# From @BotFather. Chat id: message your bot, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and read result[].message.chat.id
#
# TELEGRAM_CHAT_ID takes one id or several, comma separated — every
# alert goes to all of them. A group or channel id works too
# (negative, e.g. -1001234567890), as does @publicchannelname.
#   TELEGRAM_CHAT_ID=958113963, 123456789
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Delivery location ─────────────────────────────────
# Anything Swiggy's address search accepts: a pincode, an
# area name, or "Area, City". This picks the dark store,
# which decides both the catalogue and the prices.
IM_AREA=560001

# ─── Optional ──────────────────────────────────────────
# Routes both the browser bootstrap and the polling calls. Also
# settable from the panel, under Connection.
# socks5://user:pass@host:port  or  http://user:pass@host:port
# PROXY_URL=

# Mirrors Swiggy's deployed web build (x-build-version). Only set
# this if they start rejecting the calls; the panel can change it
# too, so a deployed install needs no redeploy.
# IM_BUILD_VERSION=2.367.0

# Set to 0 to watch the bootstrap browser (debugging only).
# IM_HEADLESS=1

# Public HTTPS url of the Mini App, so `im bot` needs no --url.
# IM_WEBAPP_URL=https://your-tunnel.trycloudflare.com

# Skips Mini App signature checks so you can open the UI in a
# normal browser. Localhost only — never on a public URL.
# IM_WEB_DEV=1

# Password for the standalone control panel (`im web`). Unset means
# loopback-only access; `im web` refuses any other --host without it.
# IM_WEB_PASSWORD=

# IM_WATCHLIST=./watchlist.json
# IM_DATA_DIR=./data
